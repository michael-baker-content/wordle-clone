# Set a long, random, stable secret before deploying. Keep it the same across
# instances and deployments so saved blackjack runs remain verifiable.
PUZZLE_SECRET=

# Optional: full public origin, e.g. https://your-domain.com.
# Link previews default to the Vercel production URL when this is unset.
SITE_URL=

# Neon server-only connection strings. Either one is sufficient at runtime;
# the pooled URL takes precedence. Never use NEXT_PUBLIC_ for these values.
DATABASE_URL=
DATABASE_URL_POOLED=
